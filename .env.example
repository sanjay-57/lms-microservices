# Environment variables read by the services (all have sensible defaults; export them before
# ./scripts/start-all.sh only if your setup differs).
#   macOS/Linux:  export DB_PASSWORD=mysecret
#   PowerShell:   $env:DB_PASSWORD="mysecret"

# ---- MySQL (local install) ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# ---- RabbitMQ (local install) ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---- Eureka ----
EUREKA_URL=http://localhost:8761/eureka

# ---- JWT (shared by gateway + all services; must be >= 32 characters) ----
JWT_SECRET=change-this-lms-dev-secret-key-min-32-chars-long
JWT_EXPIRATION_MS=86400000

# ---- CORS (gateway) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Certificates: base URL encoded in the QR code ----
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/verify

# ---- Email (notification-service). false = emails are only logged + stored ----
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@lms.local
